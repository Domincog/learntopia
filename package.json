{
  "name": "learntopia",
  "version": "1.0.0",
  "description": "Open-source interactive learning: bite-sized, hands-on lessons with spaced review. Static site, zero dependencies, no build step.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "start": "node tools/serve.mjs",
    "test": "node --test",
    "validate": "node tools/validate.mjs",
    "smoke": "node tools/smoke.mjs",
    "a11y": "node tools/a11y.mjs",
    "precache": "node tools/gen-precache.mjs",
    "check": "npm test && npm run validate"
  },
  "engines": {
    "node": ">=18"
  }
}
